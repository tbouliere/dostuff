// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:5-26-trixie",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	 "features": {

    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// sqlite3 : CLI pour interroger data/dofus.db depuis le terminal
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends sqlite3",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"

	 "mounts": [
    // Config Claude Code (login, mémoire projet, settings) partagée avec l'hôte
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",

  ],

	"customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        // Visualiseur SQLite : ouvrir data/dofus.db dans l'explorateur
        "qwtel.sqlite-viewer",
        // SQLTools + driver SQLite : explorer le schéma et exécuter des requêtes SQL
        "mtxr.sqltools",
        "mtxr.sqltools-driver-sqlite"
      ],
      "settings": {
        "sqltools.useNodeRuntime": true,
        "sqltools.connections": [
          {
            "name": "dofus.db",
            "driver": "SQLite",
            "database": "data/dofus.db"
          }
        ]
      }
    }
  }
}
